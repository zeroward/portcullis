{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    "scripts",
    "web",
    "tests",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
