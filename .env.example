NODE_ENV=development
PORT=3000
# Compose image and loopback host port (the container still listens on PORT=3000).
PORTCULLIS_IMAGE=ghcr.io/zeroward/portcullis:main
PORTCULLIS_PORT=3000
RATE_LIMIT_MAX=120
BASE_URL=http://localhost:3000
DATABASE_URL=postgres://portcullis:development@127.0.0.1:5432/portcullis
# Required by production compose.yml; generate separately (URL-safe): openssl rand -hex 24
POSTGRES_PASSWORD=
# Generate separately: openssl rand -hex 32. This example is development only.
ENCRYPTION_KEY=1111111111111111111111111111111111111111111111111111111111111111
OIDC_ISSUER=http://localhost:4100
OIDC_CLIENT_ID=portcullis
OIDC_CLIENT_SECRET=development-secret
# OIDC user subject (sub), NOT a group name. dev-owner is the mock provider's user ID.
OWNER_SUBJECT=dev-owner
# Explicit group-name-to-role mapping; add your trusted owner group here if needed.
ROLE_GROUP_MAPPINGS={"portal-support":["support"],"portal-approvers":["approver"]}
POCKET_ID_VERSION=unverified
NETBIRD_VERSION=unverified
WAYGATE_VERSION=1.0.0
# Optional game artwork and description lookup. Get a key from https://rawg.io/apidocs.
# RAWG_API_KEY=
# RAWG_API_URL=https://api.rawg.io
# Set only to existing, authorized provider instances. Keep credentials server-side.
# POCKET_ID_URL=https://id.example.com
# POCKET_ID_API_KEY=
# NETBIRD_URL=https://netbird.example.com
# NETBIRD_TOKEN=
# WAYGATE_URL=https://waygate.example.com
# MANAGEMENT_API_TOKEN=
NETBIRD_MANAGEMENT_URL=https://netbird.example.invalid
# Explicit deployment compatibility opt-in; false/absent means unavailable for these optional APIs.
CAPABILITY_OVERRIDES={"netbird.networks":false,"pocket.enrollment":false}
ENABLE_MOCK_PROVIDERS=false
TRUSTED_PROXIES=
UPLOAD_DIR=./uploads
TIMEZONE=America/Chicago
# Monitor destinations must be explicitly approved. No metadata/link-local addresses.
MONITOR_ALLOWED_CIDRS=
MONITOR_ALLOWED_DOMAINS=
MONITOR_ALLOWED_PORTS=80,443
# HEALTH_WEBHOOK_KEY=
# Optional deliveries; core in-app notifications work without these.
# SMTP_URL=smtps://user:password@mail.example.com:465
SMTP_FROM=portal@example.invalid
# DISCORD_WEBHOOK_URL=
# OUTGOING_WEBHOOK_URL=
# OUTGOING_WEBHOOK_KEY=
