{
  "name": "portcullis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:oidc": "tsx scripts/dev-oidc.ts",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src web scripts tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write \"{src,web,scripts,tests}/**/*.{ts,tsx,css}\" \"*.{json,js,ts}\"",
    "format:check": "prettier --check \"{src,web,scripts,tests}/**/*.{ts,tsx,css}\" \"*.{json,js,ts}\""
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "ipaddr.js": "2.5.0",
    "nodemailer": "10.0.13",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.11.0",
    "jose": "6.2.12",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
